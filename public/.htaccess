# Hostinger (LiteSpeed/Apache) — sitio estático exportado por Next.js
DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On

# HTTPS + dominio canónico sin www (301)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://agsupply.com.do%{REQUEST_URI} [L,R=301]

# >>> slug-redirects (generado por scripts/curate-products.mjs)
RewriteRule ^productos/cuberteria/combo-hw-1-pieza-pannez-impreso-100-1-3940/?$ /productos/cuberteria/combo-hw-1-pieza-impreso-100-1-3940/ [R=301,L]
