# ------------------------------------------------------------------------------
# AG Supply — variables de entorno. Copia a .env.local para desarrollo.
# El sitio funciona SIN ninguna de estas: por defecto lee el contenido local
# de content/*.json (CONTENT_SOURCE=local).
# ------------------------------------------------------------------------------

# Fuente de contenido: "local" (JSON en el repo) | "sanity"
CONTENT_SOURCE=local

# --- Formulario de contacto -------------------------------------------------
# Key gratuita de https://web3forms.com verificada al correo de AG Supply.
# Con ella, el formulario de /contacto envía directo al inbox. Sin ella, el
# formulario abre el cliente de correo del visitante con el mensaje pre-cargado.
NEXT_PUBLIC_WEB3FORMS_KEY=

# --- Sanity (solo si CONTENT_SOURCE=sanity) -----------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Token de LECTURA para el sitio (Viewer)
SANITY_API_READ_TOKEN=
# Token de ESCRITURA solo para scripts/seed-sanity.mjs (Editor) — NO exponer
SANITY_API_WRITE_TOKEN=
# Secreto compartido para el webhook de revalidación ISR
SANITY_REVALIDATE_SECRET=

# --- Odoo (solo para re-importar el catálogo: scripts/import-from-odoo.mjs) ---
ODOO_URL=
ODOO_DB=
ODOO_USER=
ODOO_API_KEY=
